# Local configuration for OCaml Opportunity Agent
# Copy this file to .env and fill in your own values.
# NEVER commit .env or put real credentials in this file.

# AI scoring
GROQ_API_KEY=

# Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Supabase server-side synchronization. Never expose this key in the web app.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
